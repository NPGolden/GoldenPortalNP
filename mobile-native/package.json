{
  "name": "golden-mobile-native",
  "version": "1.1.0",
  "private": true,
  "description": "Capacitor 8 shells of the three Golden A/S apps (Service Engineer, Golden PM, Customer) with native passkeys. Built by .github/workflows/build-android.yml and build-ios.yml.",
  "scripts": {
    "prepare-app": "node prepare.js",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#FFFFFF' --iconBackgroundColorDark '#1F3A5F' --splashBackgroundColor \"$SPLASH\" --splashBackgroundColorDark \"$SPLASH\"",
    "wellknown": "node wellknown.js"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-passkey": "8.5.8"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
