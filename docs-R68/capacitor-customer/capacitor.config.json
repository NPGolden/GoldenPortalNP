{
  "appId": "gr.goldenas.customer",
  "appName": "Golden A/S Portal",
  "webDir": "www",
  "server": { "androidScheme": "https", "iosScheme": "capacitor", "allowNavigation": ["goldensas.com"] },
  "ios": { "contentInset": "always", "limitsNavigationsToAppBoundDomains": true },
  "android": { "allowMixedContent": false, "captureInput": true, "webContentsDebuggingEnabled": false },
  "plugins": { "SplashScreen": { "launchShowDuration": 800, "backgroundColor": "#0A1B2E", "showSpinner": false }, "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] } }
}
