# Golden A/S Project Managers app "Golden PM" (PWA) — static client; the API is /customer/api/v1. GAS-CP-R66-001
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
  Header set Cache-Control "no-store" env=NOCACHE
</IfModule>
<FilesMatch "\.(html|webmanifest|js)$">
  SetEnv NOCACHE 1
</FilesMatch>
